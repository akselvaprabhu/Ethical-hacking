    {
      "name": "5. Demo Scenario 4: Signature Attack Payloads",
      "item": [
        {
          "name": "SQL Injection Attack Payload",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products?search=' OR '1'='1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "' OR '1'='1"
                }
              ]
            }
          }
        },
        {
          "name": "Cross-Site Scripting (XSS) Attack Payload",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products?search=<script>alert('XSS')</script>",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "<script>alert('XSS')</script>"
                }
              ]
            }
          }
        },
        {
          "name": "Path Traversal / Scanner Payload",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/products?file=../../etc/passwd",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "products"
              ],
              "query": [
                {
                  "key": "file",
                  "value": "../../etc/passwd"
                }
              ]
            }
          }
        }
